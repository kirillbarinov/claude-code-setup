<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.claude-wiki</string>
  <key>ProgramArguments</key><array>
    <string>__PYTHON__</string>
    <string>__HOME__/.claude/wiki-engine/wiki_update.py</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>__PATH__</string>
    <key>HOME</key><string>__HOME__</string>
    <key>LANG</key><string>ru_RU.UTF-8</string>
  </dict>
  <key>StartInterval</key><integer>7200</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardErrorPath</key><string>__HOME__/.claude/state/local.claude-wiki.err</string>
</dict></plist>
